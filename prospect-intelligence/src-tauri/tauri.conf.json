{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IT Architechs Prospect Intelligence",
  "version": "0.1.0",
  "identifier": "com.itarchitechs.prospectintelligence",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "IT Architechs Prospect Intelligence", "width": 1360, "height": 860, "minWidth": 1024, "minHeight": 680 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "IT Architechs",
    "shortDescription": "Discover. Qualify. Connect.",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
